{
  "expo": {
    "name": "Smiley",
    "slug": "smiley",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smiley",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0E0B10",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FCFBF0",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#0E0B10",
      "themeColor": "#0E0B10"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E0B10",
          "image": "./assets/images/logo.png",
          "imageWidth": 200
        }
      ],
      "expo-sqlite",
      "expo-video",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Smiley uses the camera so you can record reels.",
          "microphonePermission": "Smiley uses the microphone to record sound with your reels.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Smiley opens your library so you can share photos and videos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
