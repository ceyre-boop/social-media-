EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Stripe — use test-mode keys (pk_test_ / sk_test_) until launch.
# Publishable key: safe to ship in the app; EXPO_PUBLIC_ puts it in the client bundle.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
# Secret key: server-only. NO EXPO_PUBLIC_ prefix, so Expo never bundles it into the app.
# It is only for server code (e.g. a Supabase Edge Function), never read from src/.
STRIPE_SECRET_KEY=sk_test_replace_me

# Media storage backend: supabase (today) or r2 (not configured yet).
EXPO_PUBLIC_MEDIA_PROVIDER=supabase
